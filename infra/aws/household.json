{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "One Shepard Academy Universe host and retained encrypted local EBS. No automatic software deployment.",
  "Parameters": {
    "VpcId": { "Type": "AWS::EC2::VPC::Id" },
    "SubnetId": { "Type": "AWS::EC2::Subnet::Id" },
    "AvailabilityZone": { "Type": "AWS::EC2::AvailabilityZone::Name" },
    "AmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Reviewed Linux AMI for the selected region; no floating public parameter."
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.small",
      "AllowedValues": ["t3.small", "t3.medium", "t3.large"]
    },
    "AllowedHttpsCidr": {
      "Type": "String",
      "Description": "Explicit household/VPN client IPv4 CIDR"
    },
    "MonthlyBudgetUsd": { "Type": "Number", "MinValue": 1, "Default": 25 },
    "BudgetEmail": { "Type": "String" },
    "SecretArn": {
      "Type": "String",
      "Description": "Existing application secret ARN; values never enter the template."
    }
  },
  "Resources": {
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS from household; no SSH, database or model ports",
        "VpcId": { "Ref": "VpcId" },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": { "Ref": "AllowedHttpsCidr" }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "Backups": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        },
        "VersioningConfiguration": { "Status": "Enabled" },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireEncryptedBackups",
              "Status": "Enabled",
              "ExpirationInDays": 7,
              "NoncurrentVersionExpiration": { "NoncurrentDays": 7 },
              "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
            }
          ]
        }
      }
    },
    "BackupPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "Backups" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                { "Fn::GetAtt": ["Backups", "Arn"] },
                { "Fn::Sub": "${Backups.Arn}/*" }
              ],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            }
          ]
        }
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": ["ec2.amazonaws.com"] },
              "Action": ["sts:AssumeRole"]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "SpecificTutorResources",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["secretsmanager:GetSecretValue"],
                  "Resource": { "Ref": "SecretArn" }
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
                  "Resource": { "Fn::Sub": "${Backups.Arn}/backups/*" }
                }
              ]
            }
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": { "Roles": [{ "Ref": "Role" }] }
    },
    "Host": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": { "Ref": "AmiId" },
        "InstanceType": { "Ref": "InstanceType" },
        "SubnetId": { "Ref": "SubnetId" },
        "AvailabilityZone": { "Ref": "AvailabilityZone" },
        "SecurityGroupIds": [{ "Ref": "SecurityGroup" }],
        "IamInstanceProfile": { "Ref": "InstanceProfile" },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "Encrypted": true,
              "VolumeType": "gp3",
              "VolumeSize": 16,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [{ "Key": "Name", "Value": "math-practice-tutor" }]
      }
    },
    "DataVolume": {
      "Type": "AWS::EC2::Volume",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "AvailabilityZone": { "Ref": "AvailabilityZone" },
        "Encrypted": true,
        "Size": 20,
        "VolumeType": "gp3",
        "Tags": [
          {
            "Key": "Purpose",
            "Value": "Private SQLite and retained objects; local filesystem only"
          }
        ]
      }
    },
    "DataAttachment": {
      "Type": "AWS::EC2::VolumeAttachment",
      "Properties": {
        "Device": "/dev/sdf",
        "InstanceId": { "Ref": "Host" },
        "VolumeId": { "Ref": "DataVolume" }
      }
    },
    "Budget": {
      "Type": "AWS::Budgets::Budget",
      "Properties": {
        "Budget": {
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY",
          "BudgetLimit": {
            "Amount": { "Ref": "MonthlyBudgetUsd" },
            "Unit": "USD"
          }
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 80
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": { "Ref": "BudgetEmail" }
              }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "HostId": { "Value": { "Ref": "Host" } },
    "RetainedDataVolumeId": { "Value": { "Ref": "DataVolume" } },
    "EncryptedBackupBucket": { "Value": { "Ref": "Backups" } }
  }
}

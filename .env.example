# Local development reference. `make start` creates missing private settings.
# Native startup and operator Make commands load .env through uv. Never commit it.
# Provider placeholders owned by later tasks are added by those tasks.

# Local SQLite database. Absolute paths resolve identically for the API, worker,
# migrations, and commands regardless of working directory. When unset, the app
# uses the checkout's data/math_tutor.sqlite3 regardless of cwd. Relative URLs
# resolve within MATH_TUTOR_DATA_DIR (or the checkout's data directory).
#DATABASE_URL=sqlite+pysqlite:///math_tutor.sqlite3

# Optional private data directory used when DATABASE_URL is unset or relative.
#MATH_TUTOR_DATA_DIR=./data

# Adult session authentication (T02). Generate a random secret of at least 32
# characters (for example with `python3 -c
# "import secrets; print(secrets.token_urlsafe(48))"`), keep it outside Git,
# and never reuse the placeholder below: authentication rejects it at startup.
#SESSION_SECRET=GENERATE_AT_SETUP

# Same-origin public address of this deployment. It selects the Secure cookie
# flag (set for https) and the accepted Origin header on login/logout.
# Plain HTTP is accepted only for loopback; non-loopback requires HTTPS.
#APP_PUBLIC_ORIGIN=http://127.0.0.1:8000

# Private use is the default; demo permits only synthetic numeric interactions.
#APP_MODE=private
# Optional operator policy locks. Leave these unset to manage policy in Settings.
# An explicitly set value locks its corresponding control in the adult UI.
#APP_AUDIENCE=mixed
#PROVIDER_CONFIG=/absolute/path/to/private/config/providers.yaml
#ALLOW_CLOUD_INFERENCE=false
#PHOTO_RETENTION_HOURS=24
#HISTORY_RETENTION_DAYS=30
#ENABLE_EXTERNAL_PROBLEMS=false
# Provider credentials are exported separately or supplied through workload roles.
# Never add secrets to providers.example.yaml. See docs/PROVIDER_STATUS.md.
